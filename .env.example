PEYDA_PROJECT_ID=example-project
PEYDA_GROUP_ID=-1000000000001
PEYDA_TOPIC_ID=42
PEYDA_ADMIN_IDS=[123456789]
PEYDA_DATABASE_PATH=./peyda.db
# Required for explicit --doctor, --discover-telegram and live test commands.
# PEYDA_BOT_TOKEN=replace-locally

PEYDA_BATCH_QUIET_SECONDS=4
PEYDA_BATCH_CEILING_SECONDS=12
PEYDA_AGENT_TIMEOUT_SECONDS=600
PEYDA_AGENT_STARTUP_SECONDS=30
PEYDA_AGENT_CANCEL_SECONDS=5
PEYDA_ANTIGRAVITY_CLI_PATH=agy-cli
# Required for --live-agent. Choose an existing CLI conversation for this project.
# PEYDA_AGENT_WORKSPACE_PATH=/absolute/path/to/managed-project
# PEYDA_AGENT_CONVERSATION_ID=existing-conversation-id
# Explicit opt-in only after authorizing CLI access to the desktop Secret Service.
PEYDA_AGENT_DESKTOP_KEYRING=false

# Optional UTF-8 memory policy text; read once at application startup.
# PEYDA_MEMORY_POLICY_PATH=/absolute/path/to/memory-policy.md

# Live GitHub execution remains gated on validation; connection checks are authorized now.
# --live-agent does not enable GitHub execution. Do not commit real credentials.
# PEYDA_GITHUB_REPOSITORY=owner/repository
# PEYDA_GITHUB_BOT_LOGIN=github-account-login
# PEYDA_GITHUB_TOKEN=replace-locally
PEYDA_GITHUB_LIVE_VALIDATED=false
# PEYDA_MEMBER_LOGINS={"123456789":"alice","123456790":"bob","123456791":"carol"}

# Phase five. Omit either HH:MM to disable that daily notice.
PEYDA_REPORT_TIMEZONE=Asia/Tehran
# PEYDA_REPORT_AT=09:00
# PEYDA_REMINDER_AT=10:00
PEYDA_GITHUB_SYNC_SECONDS=900
PEYDA_IDLE_WORK_HOURS=72

# Integrated service only. Turbo enables the registered project file tool.
PEYDA_AGENT_TURBO=true
