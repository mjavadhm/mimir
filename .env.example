MIMIR_BOT_TOKEN=replace-with-bot-token
# Optional initial destination. Admins can set both in a private /bind conversation.
# MIMIR_GROUP_ID=-1000000000001
# MIMIR_TOPIC_ID=42
MIMIR_DATABASE_PATH=.runtime/mimir-inbox.db
MIMIR_POLL_TIMEOUT=20
MIMIR_BATCH_QUIET_SECONDS=4
MIMIR_BATCH_CEILING_SECONDS=60

# --serve uses the regular agy-cli profile and this existing ACP conversation.
MIMIR_AGENT_WORKSPACE_PATH=/path/to/managed-project
MIMIR_AGENT_CONVERSATION_ID=replace-with-existing-conversation
MIMIR_AGENT_DESKTOP_KEYRING=true
MIMIR_ADMIN_IDS=[123456789,987654321]
MIMIR_PROMPT_BYTES=32768
MIMIR_WORKER_INTERVAL=0.3
MIMIR_SCREEN_INTERVAL=4

# Set all three to enable issue coordination for this database.
# MIMIR_GITHUB_REPOSITORY=owner/repo
# MIMIR_GITHUB_BOT_LOGIN=account
# MIMIR_GITHUB_TOKEN=replace-with-repository-token

# Private channel where the bot has Post Messages permission.
# MIMIR_LOG_CHANNEL_ID=-1001234567890
