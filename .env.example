# Placeholders only. The live command reads a local .env; pytest does not.
PEYDA_BOT_TOKEN=
PEYDA_GROUP_ID=
PEYDA_TOPIC_ID=
# Comma-separated ids. A bracketed list from an older local file is also accepted.
PEYDA_ADMIN_IDS=
# Optional. When empty, the live command looks for ~/.local/bin/agy-cli and does not start it.
PEYDA_AGY_CLI=
